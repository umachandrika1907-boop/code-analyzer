[Unit]
Description=Code Change Impact Analyzer Streamlit Application
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/code_change_impact_analyzer
EnvironmentFile=/home/ubuntu/code_change_impact_analyzer/.env
ExecStart=/home/ubuntu/code_change_impact_analyzer/venv/bin/streamlit run app.py --server.port=8501 --server.address=127.0.0.1 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
